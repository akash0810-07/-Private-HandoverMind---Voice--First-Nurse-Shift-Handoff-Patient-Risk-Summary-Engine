# Copy this file to .env and fill in real values.
# NEVER commit a real .env file to Git.

# --- Flask core ---
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Database ---
# Local dev without Docker (SQLite fallback):
DATABASE_URL=sqlite:///handovermind_dev.db
# Docker Compose / production (PostgreSQL):
# DATABASE_URL=postgresql://handovermind:handovermind_dev_password@db:5432/handovermind
POSTGRES_PASSWORD=handovermind_dev_password

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- File uploads ---
MAX_UPLOAD_MB=25
AUDIO_STORAGE_BACKEND=local
AUDIO_STORAGE_PATH=/tmp/handovermind_audio
AUDIO_RETENTION_DAYS=30

# --- AI providers ---
# Set to "mock" for fully offline development/demo/CI (no API keys needed).
# Set to "whisper_api" / "openai" to use real providers once keys are added.
STT_PROVIDER=mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
AI_MAX_RETRIES=2

# --- Rate limiting ---
RATELIMIT_STORAGE_URI=memory://

# --- Boot-time convenience (deployments with no shell step, e.g. Render) ---
# Leave both false for local dev (use `flask init-db` / seed_data.py manually)
# and for a real production deploy that runs its own migrations.
AUTO_CREATE_TABLES=false
AUTO_SEED_DEMO_DATA=false

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:5000
